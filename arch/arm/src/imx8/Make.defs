# Common ARM and Cortex-M7 files

include armv7-m/Make.defs

# Required i.MX RT files

CFLAGS += -mthumb -mcpu=cortex-m7 -mfloat-abi=hard -mfpu=fpv5-d16
ASFLAGS += -mthumb -mcpu=cortex-m7

CFLAGS += -ffunction-sections -fdata-sections -g -Og
CFLAGS += -fno-instrument-functions
LDFLAGS += --gc-sections

CHIP_CSRCS  = imx8_start.c imx8_boardinit.c
CHIP_CSRCS += fsl_rdc.c fsl_clock.c pin_mux.c
CHIP_CSRCS += fsl_debug_console.c fsl_adapter_iuart.c fsl_uart.c
CHIP_CSRCS += system_cm7.c
CHIP_CSRCS += imx8_lowputc.c imx8_port_stubs.c
CHIP_CSRCS += imx8_mpuinit.c

# CHIP_CSRCS  = imxrt_allocateheap.c imxrt_start.c imxrt_periphclks.c
# CHIP_CSRCS += imxrt_irq.c imxrt_clrpend.c imxrt_gpio.c
# CHIP_CSRCS += imxrt_daisy.c imxrt_wdog.c imxrt_serial.c
# CHIP_CSRCS += imxrt_xbar.c imxrt_ocotp.c imxrt_lowputc.c
