if ARCH_BOARD_IMX8MN_DDR3_EVK_M7

choice
	prompt "Boot Flash"
	default IMX8MN_DDR3_EVK_M7_HYPER_FLASH

config IMX8MN_DDR3_EVK_M7_HYPER_FLASH
	bool "HYPER Flash"

config IMX8MN_DDR3_EVK_M7_QSPI_FLASH
	bool "QSPI Flash"

endchoice # Boot Flash

config IMX8MN_DDR3_EVK_M7_SDRAM
	bool "Enable SDRAM"
	default n
	select IMXRT_SEMC_INIT_DONE
	---help---
		Activate DCD configuration of SDRAM

endif
