include $(TOPDIR)/.config
include $(TOPDIR)/tools/Config.mk
include $(TOPDIR)/arch/arm/src/armv7-m/Toolchain.defs

ifeq ($(CONFIG_ARMV7M_DTCM),y)
  LDSCRIPT = flash-dtcm.ld
else
#  LDSCRIPT = board-tcm.ld
#  LDSCRIPT = itcm.ld
#   LDSCRIPT = board-ocram.ld
#   LDSCRIPT = flash-ocram.ld
#   LDSCRIPT = imx8mn-nuttx.ld
#   LDSCRIPT = imx8mn-itcm-flat.ld
   LDSCRIPT = boot.ld
endif

# Add board / build flags via EXTRAFLAGS so they survive the global CFLAGS := assignment
# Use -Os for size, -g for debug symbols, and section flags for gc-sections to work.
EXTRAFLAGS += -ffunction-sections -fdata-sections -Og -g
# used for earlier debugging
EXTRAFLAGS += -fno-instrument-functions

# Linker flags: prefer -Wl,--gc-sections so gcc driver forwards it correctly.
# If some link steps call ld directly, the driver will still pass --gc-sections to ld.
LDFLAGS += --gc-sections

# The arch script(s) to use
ARCHSCRIPT += $(BOARD_DIR)$(DELIM)scripts$(DELIM)$(LDSCRIPT)

ARCHPICFLAGS = -fpic -msingle-pic-base -mpic-register=r10

# Construct real flags used by the build (do not overwrite EXTRAFLAGS)
CFLAGS := $(ARCHCFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CPICFLAGS = $(ARCHPICFLAGS) $(CFLAGS)
CXXFLAGS := $(ARCHCXXFLAGS) $(ARCHOPTIMIZATION) $(ARCHCPUFLAGS) $(ARCHXXINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
CXXPICFLAGS = $(ARCHPICFLAGS) $(CXXFLAGS)
CPPFLAGS := $(ARCHINCLUDES) $(ARCHDEFINES) $(EXTRAFLAGS)
AFLAGS := $(CFLAGS) -D__ASSEMBLY__

NXFLATLDFLAGS1 = -r -d -warn-common
NXFLATLDFLAGS2 = $(NXFLATLDFLAGS1) -T$(TOPDIR)/binfmt/libnxflat/gnu-nxflat-pcrel.ld -no-check-sections
LDNXFLATFLAGS = -e main -s 2048

